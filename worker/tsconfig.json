{
  // The Worker runs on Cloudflare's runtime (not the DOM), so it gets its own type environment.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/constants/**/*.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
