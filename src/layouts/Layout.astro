---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { getLocale, locales, localeMeta, useStrings } from '../i18n/utils';

interface Props {
	title?: string;
	/** Emit canonical + hreflang alternates. Turn off for pages that exist in one locale only. */
	alternates?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const t = useStrings(locale);
const { title = t.meta.title, alternates = true } = Astro.props;
const otherLocales = locales.filter((l) => l !== locale);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#F3F6FA" />
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-jetbrains-mono" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={t.meta.description} />
		<meta property="og:locale" content={localeMeta[locale].ogLocale} />
		{otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
		{alternates && (
			<>
				<link rel="canonical" href={getAbsoluteLocaleUrl(locale, '/')} />
				{locales.map((l) => <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={getAbsoluteLocaleUrl(l, '/')} />)}
				<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('es', '/')} />
			</>
		)}
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
