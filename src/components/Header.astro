---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Logo from './brand/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocale, useStrings } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useStrings(locale);
---

<header class="sticky top-0 z-50 bg-mist/80 backdrop-blur-md border-b border-ink/10">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <Logo variant="compact" href={getRelativeLocaleUrl(locale, '/')} class="text-2xl" />

      <nav class="hidden md:flex items-center gap-8">
        <a href={`#${t.nav.services.id}`} class="text-sm font-medium text-steel hover:text-brand-500 transition-colors">{t.nav.services.label}</a>
        <a href={`#${t.nav.about.id}`} class="text-sm font-medium text-steel hover:text-brand-500 transition-colors">{t.nav.about.label}</a>
        <LanguageSwitcher />
        <a href={`#${t.nav.contact.id}`} class="px-5 py-2.5 bg-ink text-white hover:text-white text-sm font-bold rounded-lg hover:bg-ink/90 transition-colors">
          {t.nav.contact.label}
        </a>
      </nav>

      <div class="flex items-center gap-2 md:hidden">
        <LanguageSwitcher />
        <!-- Mobile menu button placeholder -->
        <button type="button" aria-label={t.nav.menuLabel} class="p-2 text-steel">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
