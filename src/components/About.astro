---
import { strings } from '../constants/strings';
---

<section id="about" class="py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/2">
        <div class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-brand-500 uppercase bg-brand-500/10 rounded-full">
          Our Story
        </div>
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-wordmark text-ink mb-6">
          {strings.about.title}
        </h2>
        <p class="text-lg text-steel mb-8 leading-relaxed">
          {strings.about.description}
        </p>
        <div class="grid grid-cols-2 gap-8 py-8 border-t border-ink/10">
          <div>
            <div class="text-3xl font-bold text-brand-500 mb-1">100%</div>
            <div class="text-sm text-steel uppercase tracking-wider font-semibold">Quality Committed</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-brand-500 mb-1">Torreón</div>
            <div class="text-sm text-steel uppercase tracking-wider font-semibold">Base of Operations</div>
          </div>
        </div>
      </div>
      <div class="lg:w-1/2 relative">
        <div class="aspect-square bg-ink/5 rounded-3xl overflow-hidden relative z-10">
            <!-- Placeholder for an engineering/tech visual -->
            <div class="absolute inset-0 flex items-center justify-center text-brand-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-24 h-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                </svg>
            </div>
        </div>
        <!-- Decorative background elements -->
        <div class="absolute -bottom-6 -right-6 w-full h-full border-4 border-brand-500/20 rounded-3xl z-0"></div>
      </div>
    </div>
  </div>
</section>
