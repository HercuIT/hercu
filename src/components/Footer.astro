---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { shared } from '../constants/strings';
import { getLocale, privacyPaths, useStrings } from '../i18n/utils';
import { whatsappAriaLabel, whatsappHref } from '../constants/whatsapp';
import Logo from './brand/Logo.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const locale = getLocale(Astro.currentLocale);
const t = useStrings(locale);
const whatsappLink = whatsappHref(shared.phone.e164, t.contact.whatsappMessage);
const currentYear = new Date().getFullYear();
---

<footer class="py-12 bg-mist border-t border-ink/10">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <Logo variant="compact" class="text-xl" />
      
      <p class="text-sm text-steel">
        &copy; {currentYear} {shared.companyName} {t.footer.rights}
        <a href={privacyPaths[locale]} class="ml-1 underline-offset-4 hover:text-ink hover:underline">{t.hercules.privacyLink}</a>
        <a href={`${getRelativeLocaleUrl(locale, '/')}#${t.nav.monitoring.id}`} class="ml-1 underline-offset-4 hover:text-ink hover:underline">{t.footer.monitoring}</a>
      </p>
      
      <div class="text-sm text-steel flex flex-col items-center md:items-end gap-1">
        <span>{shared.location}</span>
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-4">
          <a
            href={shared.phone.href}
            aria-label={`${t.contact.callPrefix} ${shared.phone.display}`}
            class="py-2 text-steel hover:text-ink whitespace-nowrap"
          >
            {shared.phone.display}
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={whatsappAriaLabel(t.contact.whatsappAria, shared.phone.display)}
            class="py-2 inline-flex items-center gap-1.5 text-steel hover:text-ink whitespace-nowrap"
          >
            <WhatsAppIcon class="w-4 h-4" tone="current" />
            {t.contact.whatsappLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
