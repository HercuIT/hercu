---
import { strings } from '../constants/strings';
import Logo from './brand/Logo.astro';
const currentYear = new Date().getFullYear();
---

<footer class="py-12 bg-mist border-t border-ink/10">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <Logo variant="compact" class="text-xl" />
      
      <p class="text-sm text-steel">
        &copy; {currentYear} {strings.companyName}. {strings.footer.rights}
      </p>
      
      <div class="text-sm text-steel">
        {strings.location}
      </div>
    </div>
  </div>
</footer>
