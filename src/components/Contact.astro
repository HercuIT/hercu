---
import { shared } from '../constants/strings';
import { useStrings } from '../i18n/utils';
import { buildServiceOptions } from '../constants/contact-services';

const t = useStrings(Astro.currentLocale);
const serviceOptions = buildServiceOptions(t.contact.service);
---

<section id={t.nav.contact.id} class="py-24 bg-ink text-white">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-16">
        <div class="lg:w-1/2">
          <h2 class="text-4xl font-display font-bold tracking-wordmark mb-6">{t.contact.title}</h2>
          <p class="text-mist/80 text-lg mb-8 leading-relaxed">
            {t.contact.description}
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="p-3 bg-brand-500/20 rounded-lg text-brand-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-white">{t.contact.locationLabel}</h4>
                <p class="text-mist/80">{shared.location}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="p-3 bg-brand-500/20 rounded-lg text-brand-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-white">{t.contact.phoneLabel}</h4>
                <a
                  href={shared.phone.href}
                  aria-label={`${t.contact.callPrefix} ${shared.phone.display}`}
                  class="text-mist/80 hover:text-white underline-offset-4 hover:underline whitespace-nowrap"
                >
                  {shared.phone.display}
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <div class="lg:w-1/2">
          <form class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-mist/80 mb-1">{t.contact.formName}</label>
              <input type="text" id="name" name="name" class="w-full px-4 py-3 bg-white/5 border border-mist/15 rounded-lg focus:ring-2 focus:ring-brand-400 focus:border-transparent outline-none transition-all text-white" placeholder={t.contact.placeholders.name} required />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-mist/80 mb-1">{t.contact.formEmail}</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 bg-white/5 border border-mist/15 rounded-lg focus:ring-2 focus:ring-brand-400 focus:border-transparent outline-none transition-all text-white" placeholder={t.contact.placeholders.email} required />
            </div>
            <div>
              <label for="service" class="block text-sm font-medium text-mist/80 mb-1">{t.contact.service.label}</label>
              <div class="relative">
                <select id="service" name="service" class="w-full appearance-none px-4 py-3 pr-11 bg-white/5 border border-mist/15 rounded-lg focus:ring-2 focus:ring-brand-400 focus:border-transparent outline-none transition-all text-white [color-scheme:dark] has-[option[value='']:checked]:text-mist/60">
                  <option value="" selected>{t.contact.service.placeholder}</option>
                  {serviceOptions.map((group) => (
                    <optgroup label={group.label}>
                      {group.options.map((option) => <option value={option.value}>{option.label}</option>)}
                    </optgroup>
                  ))}
                </select>
                <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-mist/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-mist/80 mb-1">{t.contact.formMessage}</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 bg-white/5 border border-mist/15 rounded-lg focus:ring-2 focus:ring-brand-400 focus:border-transparent outline-none transition-all text-white" placeholder={t.contact.placeholders.message} required></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-lg transition-colors shadow-lg shadow-ink/20">
              {t.contact.submit}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
