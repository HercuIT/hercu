---
import { strings } from '../constants/strings';

const serviceList = [
  strings.services.softwareDevelopment,
  strings.services.qualityConsultancy,
  strings.services.mobileApps,
  strings.services.ecommerce
];
---

<section id="services" class="py-24 bg-mist">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold tracking-wordmark text-ink mb-4">{strings.services.title}</h2>
      <div class="w-20 h-1.5 bg-brand-500 mx-auto rounded-full"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {serviceList.map((service) => (
        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-ink/10">
          <h3 class="text-xl font-bold text-ink mb-4">{service.title}</h3>
          <p class="text-steel leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
