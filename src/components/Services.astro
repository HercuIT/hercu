---
// Built from the same catalogue as the contact-form dropdown, so both always list the same services.
import { buildServiceOptions, type ServiceGroupId } from '../constants/contact-services';
import { useStrings } from '../i18n/utils';

const t = useStrings(Astro.currentLocale);
const groups = buildServiceOptions(t.contact.service);

// Heroicons outline (24px): sparkles, shield-check, code-bracket, academic-cap.
const icons: Record<ServiceGroupId, string> = {
  ai: 'M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z',
  qa: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
  development: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
  training: 'M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5',
};
---

<section id={t.nav.services.id} class="py-24 bg-mist">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold tracking-wordmark text-ink mb-4">{t.services.title}</h2>
      <p class="text-lg text-steel max-w-2xl mx-auto mb-6">{t.services.intro}</p>
      <div class="w-20 h-1.5 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {groups.map((group) => (
        <article
          aria-labelledby={`service-area-${group.id}`}
          class:list={[
            'reveal flex flex-col bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-ink/10',
            group.id === 'qa' && 'ring-2 ring-brand-500/30',
          ]}
        >
          <div class="flex items-center gap-4 mb-4">
            <span class="p-3 bg-brand-500/10 rounded-lg text-brand-500 flex-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[group.id]} />
              </svg>
            </span>
            <h3 id={`service-area-${group.id}`} class="text-xl font-bold text-ink">{group.label}</h3>
          </div>
          <p class="text-steel leading-relaxed mb-6">{t.services.groupDescriptions[group.id]}</p>
          <ul class="space-y-2 mb-8">
            {group.options.map((option) => (
              <li class="flex items-start gap-3 text-ink">
                <span aria-hidden="true" class="mt-[0.45em] box-border size-2.5 flex-none rounded-full border-2 border-brand-500"></span>
                {option.label}
              </li>
            ))}
          </ul>
          <a href={`#${t.nav.contact.id}`} class="mt-auto inline-flex items-center gap-2 font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            {t.services.cta}<span class="sr-only">: {group.label}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
