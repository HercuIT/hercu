---
// Floating button that opens Hercules. The chat code is a separate chunk imported on the first click,
// so pages load 0 KB of widget JS until a visitor asks for it (specs/hercules-assistant/03).
// On load it plays a short "power-on" intro so visitors notice it (specs/hercules-launcher-intro);
// the timings live in src/client/launcher-intro.ts, where the WCAG limits are tested.
import { shared } from '../constants/strings';
import { getLocale, privacyPaths, useStrings } from '../i18n/utils';
import LogoMark from './brand/LogoMark.astro';

const locale = getLocale(Astro.currentLocale);
const t = useStrings(locale);

// Turnstile site keys are public by design. PUBLIC_TURNSTILE_SITE_KEY can override it per build;
// `||` (not `??`) so an empty CI variable still falls back. The secret lives in the Cloudflare Secrets
// Store (TURNSTILE_SECRET binding, see wrangler.jsonc), never in the repo or in .dev.vars.
const SITE_KEY = '0x4AAAAAAFXMST0WMhwPPQv6';
const siteKey: string = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || SITE_KEY;
if (!siteKey.trim()) {
  throw new Error('HerculesLauncher: the Turnstile site key is empty; the chat could not verify visitors.');
}

const config = { locale, siteKey, strings: t.hercules, privacyHref: privacyPaths[locale], phone: shared.phone };

// Circuit traces drawn toward the button. The 140×140 box shares the launcher's bottom-right corner,
// so the button (56 px) is centred at (112, 112) and its edge is at x = 84 / y = 84.
const traces = ['M14 100 H52 V112 H84', 'M100 10 V48 H112 V84', 'M36 46 H60 V70 L92 92'];
const nodes = [
  [14, 100],
  [100, 10],
  [36, 46],
];
---

<div id="hercules-launcher-wrap" class="hl-wrap">
  <span class="hl-glow" aria-hidden="true"></span>
  <svg class="hl-traces" viewBox="0 0 140 140" aria-hidden="true" focusable="false">
    {traces.map((d) => <path class="hl-trace" d={d} pathLength="100" />)}
    <path class="hl-signal-halo" d={traces[0]} pathLength="100" />
    <path class="hl-signal" d={traces[0]} pathLength="100" />
    {nodes.map(([cx, cy]) => <circle class="hl-node" cx={cx} cy={cy} r="2.5" />)}
  </svg>
  <span class="hl-ping" aria-hidden="true"></span>
  <span class="hl-ping" aria-hidden="true"></span>
  <span class="hl-ring" aria-hidden="true"></span>

  <button
    type="button"
    id="hercules-launcher"
    data-config={JSON.stringify(config)}
    aria-label={t.hercules.open}
    aria-expanded="false"
    aria-controls="hercules-panel"
    class="hl-launcher relative flex size-14 items-center justify-center rounded-full bg-ink shadow-lg shadow-ink/30 hover:bg-ink/90"
  >
    <LogoMark decorative size={36} />
  </button>

  <div class="hl-teaser" hidden>
    <!-- Not a live region and hidden from screen readers: the launcher's own label says what it does. -->
    <span class="hl-teaser-text" aria-hidden="true">{t.hercules.teaser}</span>
    <button type="button" class="hl-teaser-close" aria-label={t.hercules.teaserDismiss}>
      <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true" focusable="false">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</div>

<style>
  .hl-wrap {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50; /* the chat panel is z-[60], so every effect stays under it */
    width: 3.5rem;
    height: 3.5rem;
  }

  /* Until the script picks a mode the button stays invisible, so it never flashes before booting.
     The launcher can't work without that script anyway (it wires the click). */
  .hl-wrap:not([data-intro]) .hl-launcher {
    opacity: 0;
  }

  .hl-launcher {
    z-index: 1;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .hl-launcher:hover {
    transform: translateY(-2px);
  }

  /* Decorative layers: never catch clicks. */
  .hl-glow,
  .hl-traces,
  .hl-ping,
  .hl-ring {
    position: absolute;
    pointer-events: none;
  }

  /* Cyan glow: once during boot, then only on hover and keyboard focus. */
  .hl-glow {
    inset: -12px;
    border-radius: 9999px;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-signal) 45%, transparent), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .hl-wrap:has(> .hl-launcher:hover) .hl-glow,
  .hl-wrap:has(> .hl-launcher:focus-visible) .hl-glow {
    opacity: 0.8;
  }

  /* 1. Boot-in (both modes). `backwards`, not `both`: after the animation, hover can move the button. */
  [data-intro] .hl-launcher {
    animation: hl-boot var(--hl-boot) cubic-bezier(0.2, 0.8, 0.2, 1.2) var(--hl-wait) backwards;
  }

  [data-intro] .hl-launcher :global(svg) {
    animation: hl-logo var(--hl-boot) ease-out var(--hl-wait) backwards;
  }

  [data-intro] .hl-glow {
    animation: hl-glow calc(var(--hl-boot) + 600ms) ease-out var(--hl-wait) 1 none;
  }

  /* Conic "scanning" arc with a cyan head, masked to a 3 px ring just outside the button. Without
     @property support the angle doesn't interpolate: the ring shows without sweeping. */
  .hl-ring {
    inset: -6px;
    border-radius: 9999px;
    opacity: 0;
    background: conic-gradient(
      from var(--hl-sweep),
      var(--color-signal) 0deg,
      color-mix(in oklab, var(--color-brand-400) 70%, transparent) 50deg,
      transparent 140deg
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
  }

  [data-intro] .hl-ring {
    animation: hl-sweep var(--hl-boot) linear var(--hl-wait) 1 none;
  }

  /* 2. Circuit traces + signal (full mode only), drawn after the boot. */
  .hl-traces {
    right: 0;
    bottom: 0;
    width: 140px;
    height: 140px;
    overflow: visible;
    opacity: 0;
  }

  .hl-trace {
    fill: none;
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .hl-signal,
  .hl-signal-halo {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 8;
  }

  /* The navy halo keeps the cyan dot visible over the site's light sections (cyan is 1.7:1 on mist). */
  .hl-signal-halo {
    stroke: var(--color-ink);
    stroke-width: 5;
  }

  .hl-signal {
    stroke: var(--color-signal);
    stroke-width: 3;
  }

  .hl-node {
    fill: var(--color-signal);
    stroke: var(--color-ink);
    stroke-width: 1;
    opacity: 0;
  }

  [data-intro='full'] .hl-traces {
    animation: hl-traces var(--hl-traces) linear calc(var(--hl-wait) + var(--hl-boot)) 1 none;
  }

  [data-intro='full'] .hl-trace {
    animation: hl-draw calc(var(--hl-traces) * 0.5) ease-out calc(var(--hl-wait) + var(--hl-boot)) 1 both;
  }

  [data-intro='full'] .hl-signal,
  [data-intro='full'] .hl-signal-halo {
    animation: hl-signal calc(var(--hl-traces) * 0.5) cubic-bezier(0.4, 0, 0.2, 1)
      calc(var(--hl-wait) + var(--hl-boot) + var(--hl-traces) * 0.35) 1 both;
  }

  [data-intro='full'] .hl-node {
    animation: hl-node calc(var(--hl-traces) * 0.4) ease-out calc(var(--hl-wait) + var(--hl-boot)) 1 both;
  }

  /* 3. Pings: cyan rings with a navy halo, after the traces (full) or right after the boot (short). */
  .hl-ping {
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-signal);
    box-shadow:
      0 0 0 1px var(--color-ink),
      inset 0 0 0 1px var(--color-ink);
    opacity: 0;
  }

  [data-intro] .hl-ping {
    animation: hl-ping var(--hl-ping) cubic-bezier(0, 0, 0.2, 1) calc(var(--hl-wait) + var(--hl-boot) + var(--hl-traces)) 1 none;
  }

  [data-intro] .hl-ping + .hl-ping {
    animation-delay: calc(var(--hl-wait) + var(--hl-boot) + var(--hl-traces) + var(--hl-ping-gap));
  }

  [data-intro='short'] .hl-ping + .hl-ping,
  [data-intro='short'] .hl-traces {
    display: none;
  }

  /* 4. Teaser bubble: mist on ink (well over 4.5:1); the cyan is only a decorative edge. */
  .hl-teaser {
    position: absolute;
    right: calc(100% + 12px);
    bottom: 6px;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    width: max-content;
    max-width: min(17rem, calc(100vw - 6rem));
    padding: 0.5rem 0.375rem 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border-left: 2px solid var(--color-signal);
    background: var(--color-ink);
    color: var(--color-mist);
    font-size: 0.875rem;
    line-height: 1.35;
    box-shadow: 0 10px 25px -5px rgb(20 35 58 / 0.35);
  }

  .hl-teaser[hidden] {
    display: none;
  }

  /* Phones: beside the launcher it would cover the hero's left-aligned CTA, so it sits above it. */
  @media (max-width: 639px) {
    .hl-teaser {
      right: 0;
      bottom: calc(100% + 12px);
    }

    .hl-teaser[data-state='in'] {
      animation-name: hl-teaser-up;
    }
  }

  .hl-teaser[data-state='in'] {
    animation: hl-teaser-in var(--hl-teaser-in) cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hl-teaser[data-state='out'] {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .hl-teaser-text {
    cursor: pointer;
    padding-top: 0.125rem;
  }

  .hl-teaser-close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    color: var(--color-mist);
  }

  .hl-teaser-close:hover {
    background: rgb(243 246 250 / 0.12);
  }

  @keyframes hl-boot {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hl-logo {
    from {
      opacity: 0.4;
    }
  }

  @keyframes hl-glow {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes hl-sweep {
    0% {
      opacity: 0;
      --hl-sweep: 0deg;
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      --hl-sweep: 360deg;
    }
  }

  @keyframes hl-traces {
    0%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes hl-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hl-signal {
    to {
      stroke-dashoffset: -92;
    }
  }

  @keyframes hl-node {
    to {
      opacity: 1;
    }
  }

  @keyframes hl-ping {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  @keyframes hl-teaser-in {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
  }

  @keyframes hl-teaser-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes hl-fade {
    from {
      opacity: 0;
    }
  }

  /* Reduced motion: nothing scales, sweeps, draws, pings or slides. The launcher and teaser only fade. */
  @media (prefers-reduced-motion: reduce) {
    .hl-ring,
    .hl-traces,
    .hl-ping {
      display: none;
    }

    [data-intro] .hl-glow,
    [data-intro] .hl-launcher :global(svg) {
      animation: none;
    }

    [data-intro] .hl-launcher {
      animation: hl-fade 200ms linear var(--hl-wait) backwards;
    }

    .hl-launcher,
    .hl-launcher:hover {
      transform: none;
      transition: background-color 0.2s ease;
    }

    .hl-teaser[data-state='in'] {
      animation: hl-fade 200ms linear both;
    }
  }

  @media print {
    .hl-wrap {
      display: none;
    }
  }
</style>

<script>
  import { introMode, markIntroSeen, teaserStartsAt, TEASER_VISIBLE_MS, timelineFor, timelineVars } from '../client/launcher-intro';
  import { createWidgetLoader } from '../client/widget-loader';

  /** sessionStorage, or null when the browser blocks it (the getter itself can throw). */
  function sessionStore(): Storage | null {
    try {
      return window.sessionStorage;
    } catch {
      return null;
    }
  }

  const wrap = document.getElementById('hercules-launcher-wrap');
  const launcher = document.getElementById('hercules-launcher');
  if (wrap && launcher) {
    // Pick the intro first: until data-intro is set, the CSS keeps the button invisible.
    const storage = sessionStore();
    const mode = introMode(storage);
    const timeline = timelineFor(mode);
    for (const [name, value] of Object.entries(timelineVars(timeline))) wrap.style.setProperty(name, value);
    wrap.dataset.intro = mode;

    const teaser = wrap.querySelector<HTMLElement>('.hl-teaser');
    const timers: number[] = [];
    const hideTeaser = () => {
      timers.forEach((id) => window.clearTimeout(id));
      if (!teaser || teaser.hidden) return;
      teaser.dataset.state = 'out';
      window.setTimeout(() => (teaser.hidden = true), 200);
    };
    if (mode === 'full') {
      // Seen as soon as it starts, so navigating away mid-sequence doesn't replay it in full.
      markIntroSeen(storage, 'played');
      if (teaser) {
        timers.push(
          window.setTimeout(() => {
            teaser.hidden = false;
            teaser.dataset.state = 'in';
            timers.push(window.setTimeout(hideTeaser, TEASER_VISIBLE_MS));
          }, teaserStartsAt(timeline)),
        );
      }
    }
    teaser?.querySelector('.hl-teaser-close')?.addEventListener('click', () => {
      markIntroSeen(storage, 'dismissed');
      hideTeaser();
    });
    teaser?.querySelector('.hl-teaser-text')?.addEventListener('click', () => launcher.click());
    const chatOpened = () => {
      markIntroSeen(storage, 'opened');
      hideTeaser();
    };

    const config = JSON.parse(launcher.dataset.config ?? '{}');
    config.logoHtml = launcher.querySelector('svg')?.outerHTML ?? '';
    // Download once, ignore clicks while loading, retry after a failed download (see widget-loader.ts).
    const run = createWidgetLoader(() => import('../client/hercules-widget'));
    launcher.addEventListener('click', () => {
      chatOpened();
      void run((mod) => mod.toggleHercules(config, launcher));
    });
    // Secondary entry points (e.g. the hero link) only appear once this script runs, and only open.
    for (const trigger of document.querySelectorAll<HTMLElement>('[data-hercules-open]')) {
      trigger.hidden = false;
      trigger.addEventListener('click', () => {
        chatOpened();
        void run((mod) => mod.openHercules(config, launcher));
      });
    }
  }
</script>
