---
// Geometry is copied verbatim from the approved primary-logo mockup; do not alter coordinates or strokes.
import { useStrings } from '../../i18n/utils';

interface Props {
  /** Width and height of the (square) mark box. Numbers are px. */
  size?: number | string;
  /** Hide from assistive tech when visible text already names the brand. */
  decorative?: boolean;
  class?: string;
}

const { size = 40, decorative = false, class: className } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
const t = useStrings(Astro.currentLocale);
const a11y = decorative
  ? { 'aria-hidden': 'true' as const }
  : { role: 'img' as const, 'aria-label': t.brand.markLabel };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="20 30 160 145"
  class:list={['logo-mark shrink-0', className]}
  style={`width:${dimension};height:${dimension}`}
  focusable="false"
  {...a11y}
>
  <path fill="var(--color-brand-500)" d="M100 40 L132 44 L170 62 L150 74 L162 106 L148 130 L128 138 L124 158 L100 166 L76 158 L72 138 L52 130 L38 106 L50 74 L30 62 L68 44 Z" />
  <path fill="var(--color-ink)" fill-opacity="0.28" d="M68 44 L50 74 L30 62 Z M132 44 L150 74 L170 62 Z" />
  <path fill="none" stroke="var(--color-mist)" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" d="M100 56 V116 M100 78 L88 66 M100 78 L112 66" />
  <circle cx="100" cy="53" r="5.5" fill="var(--color-brand-500)" stroke="var(--color-mist)" stroke-width="4" />
  <circle cx="87" cy="64" r="4.5" fill="var(--color-brand-500)" stroke="var(--color-mist)" stroke-width="4" />
  <circle cx="113" cy="64" r="4.5" fill="var(--color-brand-500)" stroke="var(--color-mist)" stroke-width="4" />
  <ellipse cx="78" cy="97" rx="8" ry="5.5" transform="rotate(12 78 97)" fill="var(--color-ink)" />
  <ellipse cx="122" cy="97" rx="8" ry="5.5" transform="rotate(-12 122 97)" fill="var(--color-ink)" />
  <path fill="var(--color-ink)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="round" d="M86 124 L114 124 L108 138 L92 138 Z" />
  <path fill="none" stroke="var(--color-ink)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" d="M100 142 V150 M86 152 L100 150 L114 152" />
</svg>

<style>
  @media (forced-colors: active) {
    .logo-mark {
      forced-color-adjust: none;
    }
  }
</style>
