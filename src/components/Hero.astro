---
import CircuitPulse from './CircuitPulse.astro';
import { useStrings } from '../i18n/utils';

const t = useStrings(Astro.currentLocale);
---

<section class="hero relative isolate py-20 overflow-hidden bg-white">
  <CircuitPulse />
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-6xl font-display font-bold tracking-wordmark text-ink mb-6">
        {t.hero.title}
      </h1>
      <p class="text-xl text-steel mb-10 leading-relaxed">
        {t.hero.subtitle}
      </p>
      <div class="flex flex-col items-start">
        <a href={`#${t.nav.contact.id}`} class="px-8 py-4 bg-brand-500 text-white hover:text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/20">
          {t.hero.cta}
        </a>
        <p class="mt-3 text-sm text-steel">{t.hero.ctaSupport}</p>
      </div>
    </div>
  </div>
  
</section>
