---
import { strings } from '../constants/strings';
---

<section class="relative py-20 overflow-hidden bg-white">
  <div class="container mx-auto px-4 relative">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-6xl font-display font-bold tracking-wordmark text-ink mb-6">
        {strings.hero.title}
      </h1>
      <p class="text-xl text-steel mb-10 leading-relaxed">
        {strings.hero.subtitle}
      </p>
      <div class="flex flex-col items-start">
        <a href="#contact" class="px-8 py-4 bg-brand-500 text-white hover:text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/20">
          {strings.hero.cta}
        </a>
        <p class="mt-3 text-sm text-steel">{strings.hero.ctaSupport}</p>
      </div>
    </div>
  </div>
  
  <!-- Subtle decorative element -->
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl opacity-50"></div>
</section>
