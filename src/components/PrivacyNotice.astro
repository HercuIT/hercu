---
// Aviso de Privacidad / Privacy Notice (LFPDPPP). The text is a DRAFT pending legal review, so the page
// is noindex and shows a visible draft banner until legal approves it (specs/hercules-assistant/04 §3).
import Layout from '../layouts/Layout.astro';
import { shared } from '../constants/strings';
import { useStrings } from '../i18n/utils';
import Footer from './Footer.astro';
import Header from './Header.astro';

const t = useStrings(Astro.currentLocale);
---

<Layout title={`${t.privacy.title} · ${shared.brand.name}`} alternates={false}>
  <meta slot="head" name="robots" content="noindex" />
  <Header />
  <main class="container mx-auto max-w-3xl px-4 py-16">
    <p class="mb-8 rounded-lg border border-brand-500/30 bg-brand-500/10 px-4 py-3 text-sm font-semibold text-ink" role="note">
      {t.privacy.draftNotice}
    </p>
    <h1 class="mb-2 font-display text-4xl font-bold tracking-wordmark text-ink">{t.privacy.title}</h1>
    <p class="mb-10 text-sm text-steel">{t.privacy.updated}</p>
    {t.privacy.sections.map((section) => (
      <section class="mb-8">
        <h2 class="mb-2 text-xl font-bold text-ink">{section.heading}</h2>
        <p class="leading-relaxed text-steel">{section.body}</p>
      </section>
    ))}
  </main>
  <Footer />
</Layout>
