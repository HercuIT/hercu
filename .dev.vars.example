# Local `wrangler dev` notes. Never commit real values.
# ANTHROPIC_API_KEY and TURNSTILE_SECRET are Cloudflare Secrets Store bindings (see wrangler.jsonc),
# so they are NOT read from this file. For local dev, create them in the local secrets store:
#   wrangler secrets-store secret create 0086f10401674b139c72e268df0bd4a0 --name ANTHROPIC_API_KEY --scopes workers
#   wrangler secrets-store secret create 0086f10401674b139c72e268df0bd4a0 --name TURNSTILE_SECRET --scopes workers
# (add --remote to target the production store instead).
#
# Plain vars can be overridden here. Local only: the widget must list localhost among its domains.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
